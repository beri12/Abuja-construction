# Public site URL — used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://zelalemconstruction.com

# Sanity CMS (optional). When these are set, content is fetched from Sanity;
# otherwise the app falls back to the bundled local content in src/lib/content.
NEXT_PUBLIC_SANITY_PROJECT_ID=eyhdaj52
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only Sanity token for authenticated reads/writes (never expose to client).
SANITY_API_READ_TOKEN=
